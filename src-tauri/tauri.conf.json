{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weekly Study Planner",
  "version": "1.0.0",
  "identifier": "com.studyplanner.weekly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "برنامه‌ریز درسی هفتگی — Weekly Study Planner",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
