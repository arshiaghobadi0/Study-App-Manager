# Maintainer: Weekly Study Planner
pkgname=weekly-study-planner
pkgver=1.0.0
pkgrel=1
pkgdesc="Weekly study task planner (100% Pure Rust / iced) with Jalali/Gregorian dates, reminders, analytics, PDF and JSON backup"
arch=('x86_64')
url="https://github.com/OWNER/REPO"
license=('Apache-2.0')
depends=('fontconfig' 'libxkbcommon' 'wayland' 'libx11' 'hicolor-icon-theme')
makedepends=('rust' 'cargo')
source=()
sha256sums=()

build() {
  cd "${startdir}/../../desktop"
  cargo build --release
}

check() {
  cd "${startdir}/../../desktop"
  cargo test
}

package() {
  cd "${startdir}/../.."
  install -Dm755 "desktop/target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "desktop/assets/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png"
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/${pkgname}.desktop" << 'EOF'
[Desktop Entry]
Name=Weekly Study Planner
Comment=Weekly study task planner (Pure Rust) with Jalali/Gregorian dates
Exec=weekly-study-planner %U
Terminal=false
Type=Application
Icon=weekly-study-planner
Categories=Education;Office;
EOF
}
